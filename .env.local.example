# ============================================================
# AgentFlow — variáveis de ambiente
# Copie para .env.local e preencha. NÃO versione .env.local.
# ============================================================

# ------------------------------------------------------------
# Firebase (cliente)
# ------------------------------------------------------------
# Expostas no bundle do browser por desenho — são identificadores públicos do
# projeto, não segredos. A proteção real dos dados vem de firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------
# Governança / Zero-Trust (SERVIDOR — nunca use prefixo NEXT_PUBLIC_)
# ------------------------------------------------------------

# Chave-mestra (KEK) do cofre de credenciais e da trilha de auditoria.
# Mínimo de 32 bytes (256 bits), em base64. Gere com:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Desta chave são derivadas, via HKDF, três subchaves independentes:
#   - cifragem das credenciais do cofre;
#   - assinatura HMAC da trilha de auditoria;
#   - cifragem dos detalhes sensíveis dos eventos de auditoria.
#
# PERDER ESTA CHAVE TORNA TODAS AS CREDENCIAIS JÁ CIFRADAS IRRECUPERÁVEIS e
# invalida a verificação de assinatura da trilha existente. Em produção, injete
# a partir de um gerenciador de segredos (Google Secret Manager, AWS Secrets
# Manager), não de um arquivo em disco.
AGENTFLOW_VAULT_KEK=

# Versão da chave-mestra, registrada em cada envelope. Ao rotacionar a KEK,
# incremente aqui (v2, v3, ...) para que os envelopes antigos continuem
# identificáveis e possam ser re-envelopados.
AGENTFLOW_VAULT_KEK_VERSION=v1

# ID do projeto Firebase usado para validar `iss` e `aud` do ID token nas rotas
# de API. Se ausente, cai para NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# ------------------------------------------------------------
# Firebase Admin SDK (SERVIDOR — nunca use prefixo NEXT_PUBLIC_)
# ------------------------------------------------------------
# Usado por três subsistemas que um cliente comum não pode operar (ver
# src/lib/server/firebaseAdmin.ts): o limitador de taxa distribuído, o selo
# atômico da trilha de auditoria e a escrita de `flowRuns` pelo motor de
# orquestração — todos negados a um cliente comum em firestore.rules.
#
# Preencha APENAS UMA das duas variáveis abaixo:

# Opção 1 (recomendada em serverless — Cloud Run, Vercel): o JSON da conta de
# serviço inteiro, em uma única linha, nesta variável de ambiente. Não há
# sistema de arquivos persistente para montar um .json nesses ambientes.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Opção 2 (desenvolvimento local): caminho para o arquivo .json da conta de
# serviço. Resolvido automaticamente pelas Application Default Credentials do
# Google quando FIREBASE_SERVICE_ACCOUNT_JSON está vazio.
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------
# Motor de orquestração (SERVIDOR — nunca use prefixo NEXT_PUBLIC_)
# ------------------------------------------------------------
# Usado por /api/flows/execute para chamar um modelo real da Anthropic,
# validado pelo Motor de Guardrails antes e depois da chamada. Sem esta
# chave, a rota responde 503 de forma controlada — nunca derruba o processo.
ANTHROPIC_API_KEY=

# Modelo usado pelo motor de orquestração. Padrão: claude-sonnet-5.
AGENTFLOW_ORCHESTRATOR_MODEL=claude-sonnet-5

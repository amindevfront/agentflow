rules_version = '2';

// Regras escopadas por workspaceId desde a v1, mesmo operando single-tenant
// (ver docs/architecture/adr-0001-workspace-model.md). Qualquer leitura/escrita
// exige um usuário autenticado que pertença ao workspace do documento.
//
// As coleções de governança (credentials, credentialSecrets, auditLogs,
// auditChainHead, hitlTickets, _rateLimits, channelReputationQueue) aplicam
// privilégio mínimo de forma determinística no banco, e não por confiança no
// código de aplicação:
//
//   - `credentialSecrets` nega LEITURA a todo cliente. O envelope cifrado só é
//     acessível ao motor de orquestração via Admin SDK, que não passa por estas
//     regras. Mesmo um cliente comprometido não obtém o ciphertext — e, sem a
//     chave-mestra que vive apenas no servidor, ele seria inerte. A criação é
//     adicionalmente amarrada a uma credencial real do mesmo workspace (exceto
//     na primeira versão, quando a credencial-mãe ainda não existe).
//   - `auditLogs` e `auditChainHead` negam TODA escrita de cliente. O selo e a
//     persistência da trilha migraram para uma transação do Admin SDK no
//     servidor (`/api/audit/seal` → `src/lib/server/auditChainStore.ts`), que
//     elimina a corrida que existia quando o cliente lia a última entrada e
//     escrevia a própria com retry otimista em caso de colisão.
//   - `_rateLimits` é infraestrutura interna do limitador de taxa distribuído
//     (`src/lib/server/distributedRateLimit.ts`) — nunca lida nem escrita por
//     um cliente, só pelo Admin SDK.
//   - `messageVaults` (Neural Inbox) espelha `credentialSecrets`: nega leitura
//     a todo cliente. `conversations/{id}/mensagens` é append-only (nenhum
//     `update`/`delete`) — uma transcrição de chat é registro, não rascunho.
//   - `campaigns`/`destinatarios` restringem criação/controle a administradores
//     — disparo em massa é ação de maior risco (spam, compliance); o avanço de
//     status de cada envio é exclusivo do Admin SDK (`/api/campaigns/tick`).
//
// Limite honesto: quem detém credenciais de administrador do projeto Firebase
// (console ou Admin SDK) pode contornar estas regras. Elas protegem contra um
// CLIENTE comprometido ou malicioso, não contra o operador do próprio projeto.

service cloud.firestore {
  match /databases/{database}/documents {

    // As funções ficam dentro do bloco `match`: é onde a linguagem de regras
    // aceita declará-las.
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToWorkspace(workspaceId) {
      return isSignedIn() && userDoc().workspaceId == workspaceId;
    }

    function isAdminOf(workspaceId) {
      return isSignedIn()
             && userDoc().workspaceId == workspaceId
             && userDoc().papel == 'admin';
    }

    match /workspaces/{workspaceId} {
      allow read: if belongsToWorkspace(workspaceId);
      // Criação acontece durante o onboarding (ver ADR-0002), antes de existir
      // um documento em `users/{uid}` — por isso não pode exigir
      // `isAdminOf`, que depende desse documento já existir. Qualquer usuário
      // autenticado pode criar um novo workspace (self-serve signup); isso só
      // cria o registro em si, nada sensível é exposto por essa operação, e
      // a leitura/atualização subsequentes continuam exigindo pertencimento.
      // `donoUid` tem de ser o próprio criador — é nele que a regra de
      // `users/{uid}` abaixo se apoia para confirmar uma autodeclaração de
      // admin legítima (dono do próprio workspace novo), nunca de um
      // workspace de outro tenant.
      allow create: if isSignedIn() && request.resource.data.donoUid == request.auth.uid;
      // Configuração do workspace (nome, roiConfig) é operação administrativa:
      // os parâmetros de ROI determinam os números financeiros reportados.
      allow update: if isAdminOf(workspaceId);
      allow delete: if false;
    }

    match /users/{uid} {
      // Ler o próprio documento é sempre permitido, inclusive antes dele
      // existir (bootstrap do primeiro login): o operador `||` do CEL faz
      // curto-circuito, então `resource.data` nunca é tocado nesse ramo.
      // Ler o documento de outra pessoa exige pertencer ao MESMO workspace —
      // sem isso, qualquer usuário autenticado conseguiria enumerar nome,
      // e-mail e papel de usuários de outros workspaces.
      allow read: if isSignedIn() && (request.auth.uid == uid || belongsToWorkspace(resource.data.workspaceId));

      // `papel`/`workspaceId` NUNCA são uma escolha livre de quem escreve o
      // próprio documento — sem esta checagem, qualquer usuário autenticado
      // se autodeclararia `admin` de QUALQUER workspace só por conhecer (ou
      // adivinhar) o id, o que destrói o isolamento entre tenants por
      // completo, inclusive o cofre, a trilha de auditoria e o SAC Shield de
      // terceiros. Dois caminhos legítimos, nenhum outro:
      //
      //  1. Onboarding self-serve: o usuário acabou de criar o PRÓPRIO
      //     workspace (`donoUid`, ver `prepareWorkspace`) e se declara admin
      //     dele. `workspaces/{workspaceId}` pode ainda não existir no
      //     momento desta escrita — a ordem deliberada do onboarding grava
      //     `users/{uid}` antes de `workspaces/{workspaceId}` para que o
      //     retry seja seguro (ver `src/app/onboarding/page.tsx`), então
      //     aceitar "ainda não existe" é necessário, não uma folga
      //     acidental. Limite honesto: dois usuários colidindo no mesmo id
      //     de workspace recém-gerado (aleatório, 20+ caracteres) antes de
      //     qualquer um persistir o documento do workspace é a única janela
      //     que isto não cobre — não é uma colisão alcançável de fora.
      //  2. Convite aceito: `papel`/`workspaceId` têm de ser EXATAMENTE os
      //     do convite pendente referenciado por `conviteAceitoId`, e o
      //     e-mail do convite tem de casar com o e-mail autenticado deste
      //     token — ninguém aceita um convite endereçado a outra pessoa.
      allow create: if isSignedIn() && request.auth.uid == uid
                    && (
                         (
                           request.resource.data.papel == 'admin'
                           && (
                                !exists(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId))
                                || get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.donoUid == request.auth.uid
                              )
                         )
                         || (
                           request.resource.data.conviteAceitoId is string
                           && get(/databases/$(database)/documents/invites/$(request.resource.data.conviteAceitoId)).data.status == 'pendente'
                           && get(/databases/$(database)/documents/invites/$(request.resource.data.conviteAceitoId)).data.workspaceId == request.resource.data.workspaceId
                           && get(/databases/$(database)/documents/invites/$(request.resource.data.conviteAceitoId)).data.papel == request.resource.data.papel
                           && get(/databases/$(database)/documents/invites/$(request.resource.data.conviteAceitoId)).data.email == request.auth.token.email.lower()
                         )
                       );

      // O próprio usuário ajusta nome/avatar livremente, mas `papel` e
      // `workspaceId` são imutáveis depois de criados: não existe fluxo
      // legítimo de autopromoção ou troca de tenant por reescrita direta do
      // próprio documento — mudar o papel de alguém hoje só acontece por um
      // novo convite, nunca por edição in-place.
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.papel == resource.data.papel
                    && request.resource.data.workspaceId == resource.data.workspaceId;

      // Nada no produto apaga este documento hoje; negar por padrão evita
      // que alguém o apague e o recrie como atalho para contornar as
      // checagens de `create` acima.
      allow delete: if false;
    }

    match /invites/{inviteId} {
      // Leitura do próprio convite é necessária antes do login (fluxo de aceite),
      // por isso não exige autenticação prévia — o id do convite funciona como token.
      allow get: if true;
      allow list: if belongsToWorkspace(resource.data.workspaceId);
      // Só administradores enviam convites — inclusive escolher `papel` é
      // decisão administrativa (a UI de `/team` já é exclusiva de admin;
      // esta checagem torna isso verdade também no banco, não só na tela,
      // e é o que impede um convite de admin forjado por um `operacoes`).
      allow create: if isAdminOf(request.resource.data.workspaceId)
                    && request.resource.data.status == 'pendente';
      // Única transição legítima depois de criado é pendente -> aceito, feita
      // por quem está completando o cadastro — ainda não pertence ao
      // workspace nesse momento, por isso não dá para exigir
      // `belongsToWorkspace` aqui. Todo o resto é imutável: nem o workspace,
      // nem o papel, nem o e-mail do convite mudam depois de criado — sem
      // isso, qualquer usuário autenticado poderia reescrever um convite de
      // outro tenant para apontar para si mesmo com `papel: 'admin'`.
      allow update: if isSignedIn()
                    && resource.data.status == 'pendente'
                    && request.resource.data.status == 'aceito'
                    && request.resource.data.workspaceId == resource.data.workspaceId
                    && request.resource.data.papel == resource.data.papel
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.criadoPor == resource.data.criadoPor
                    && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if false;
    }

    match /flows/{flowId} {
      allow read, write: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if belongsToWorkspace(request.resource.data.workspaceId);
    }

    match /flowRuns/{runId} {
      allow read: if belongsToWorkspace(resource.data.workspaceId);
      allow write: if false; // criadas apenas pelo motor de orquestração (Admin SDK)
    }

    match /connectors/{connectorId} {
      allow read: if belongsToWorkspace(resource.data.workspaceId);
      allow delete: if belongsToWorkspace(resource.data.workspaceId);
      // Conector "Telegram Bot API" é admin-only (o segredo de webhook e o
      // token do bot vão pro Cofre Zero-Trust, que já exige `isAdminOf` para
      // escrever `credentials`/`credentialSecrets` — sem este espelhamento
      // aqui, essa restrição existia só no cliente (`connectors/page.tsx`),
      // e qualquer membro não-admin que chamasse o SDK do Firestore direto
      // criaria/alteraria o conector mesmo assim).
      allow create: if belongsToWorkspace(request.resource.data.workspaceId)
                    && (request.resource.data.tipo != 'Telegram Bot API'
                        || isAdminOf(request.resource.data.workspaceId));
      allow update: if belongsToWorkspace(resource.data.workspaceId)
                    && (resource.data.tipo != 'Telegram Bot API'
                        || isAdminOf(resource.data.workspaceId));
    }

    // ---------- Governança: cofre de credenciais ----------

    match /credentials/{credentialId} {
      // Metadados (nome, tipo, versão, sufixo, impressão) são visíveis ao
      // workspace: a operação precisa saber o que existe para diagnosticar um
      // fluxo. Nenhum campo aqui contém o segredo.
      allow read: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if isAdminOf(request.resource.data.workspaceId)
                    && request.resource.data.status == 'ativa'
                    && request.resource.data.versao == 1
                    // O campo `id` tem de corresponder ao id real do documento —
                    // fecha a possibilidade de um metadado apontar, por engano
                    // ou má-fé, para um `credentialId` diferente do seu próprio.
                    && request.resource.data.id == credentialId;
      // Atualização cobre rotação (nova versão) e revogação. O workspace e o id
      // são imutáveis, para que uma credencial não seja movida de tenant.
      allow update: if isAdminOf(resource.data.workspaceId)
                    && request.resource.data.workspaceId == resource.data.workspaceId
                    && request.resource.data.id == resource.data.id;
      // Nunca apagar: a trilha precisa poder responder "esta credencial existiu
      // e foi revogada em tal data".
      allow delete: if false;
    }

    match /credentialSecrets/{secretId} {
      // NENHUM cliente lê o envelope cifrado. Apenas o Admin SDK, no servidor.
      allow read: if false;

      allow create: if isAdminOf(request.resource.data.workspaceId)
                    && request.resource.data.credentialId is string
                    && request.resource.data.versao is int
                    && request.resource.data.versao > 0
                    && request.resource.data.envelope.algoritmo == 'AES-256-GCM'
                    && request.resource.data.envelope.ciphertext is string
                    && request.resource.data.envelope.aad is string
                    // O id do segredo tem de começar com o `credentialId` que
                    // ele próprio declara — sem isso, nada impede um cliente de
                    // gravar um segredo "órfão" sob um id arbitrário.
                    && secretId.split('__v')[0] == request.resource.data.credentialId
                    // Primeira versão: a credencial-mãe ainda não existe (o
                    // cliente grava o segredo antes do metadado, deliberadamente
                    // — ver `armazenarCredencial`). A partir da segunda versão
                    // (rotação), a credencial-mãe já existe, pertence ao mesmo
                    // workspace, e sua versão registrada é estritamente menor
                    // que a que está sendo criada agora — isto é o que impede
                    // regravar uma versão antiga ou pular posições.
                    && (
                         request.resource.data.versao == 1
                         || (
                              exists(/databases/$(database)/documents/credentials/$(request.resource.data.credentialId))
                              && get(/databases/$(database)/documents/credentials/$(request.resource.data.credentialId)).data.workspaceId == request.resource.data.workspaceId
                              && get(/databases/$(database)/documents/credentials/$(request.resource.data.credentialId)).data.versao < request.resource.data.versao
                            )
                       );
      // Imutável: rotação cria uma nova versão, nunca sobrescreve a anterior.
      allow update, delete: if false;
    }

    // ---------- Governança: trilha de auditoria imutável ----------
    //
    // Toda a escrita (selo + avanço do ponteiro da cadeia) acontece dentro de
    // uma transação do Admin SDK em `/api/audit/seal` — ver
    // `src/lib/server/auditChainStore.ts`. Nenhum cliente escreve aqui.

    match /auditLogs/{entryId} {
      allow read: if belongsToWorkspace(resource.data.workspaceId);
      allow write: if false;
    }

    match /auditChainHead/{workspaceId} {
      // O ponteiro em si (posição e hash atuais da cadeia) não é sensível —
      // expô-lo para leitura permite que a UI mostre "N eventos registrados"
      // sem precisar carregar a trilha inteira.
      allow read: if belongsToWorkspace(workspaceId);
      allow write: if false;
    }

    // ---------- Governança: transbordo humano (HITL) ----------

    match /hitlTickets/{ticketId} {
      allow read: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if belongsToWorkspace(request.resource.data.workspaceId)
                    && request.resource.data.status == 'aberto';
      // Decisões de transbordo são transições de estado. O workspace, o fluxo e
      // o payload mascarado são imutáveis: um revisor não reescreve o caso que
      // está julgando.
      allow update: if belongsToWorkspace(resource.data.workspaceId)
                    && request.resource.data.workspaceId == resource.data.workspaceId
                    && request.resource.data.flowId == resource.data.flowId
                    && request.resource.data.traceId == resource.data.traceId
                    && request.resource.data.payloadMascarado == resource.data.payloadMascarado
                    && request.resource.data.criadoEm == resource.data.criadoEm
                    && request.resource.data.slaExpiraEm == resource.data.slaExpiraEm;
      allow delete: if false;
    }

    // ---------- Infraestrutura interna: limitador de taxa distribuído ----------

    match /_rateLimits/{bucketId} {
      allow read, write: if false;
    }

    // ---------- SAC Shield: fila de reenvio da Blindagem de Reputação de Canal ----------
    //
    // `channelReputationQueue` é infraestrutura interna do SAC Shield
    // (`src/lib/server/channelReputationShieldAdmin.ts`), mesmo desenho de
    // `_rateLimits`: nunca lida nem escrita por um cliente, só pelo Admin SDK
    // em `/api/campaigns/tick`. Guarda o hash do destino e a referência de
    // reenvio, nunca o destino em claro.

    match /channelReputationQueue/{itemId} {
      allow read, write: if false;
    }

    // ---------- Neural Inbox: atendimento omnichannel ----------
    //
    // `messageVaults` segue o mesmo desenho de `credentialSecrets`: nega
    // leitura a todo cliente, cifra só é acessível por extração formal de
    // compliance (trabalho futuro, server-only). `mensagens` é imutável uma
    // vez enviada — um chat é um registro de auditoria, não um documento
    // editável.

    match /conversations/{conversationId} {
      allow read, update: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if belongsToWorkspace(request.resource.data.workspaceId);
      allow delete: if false;

      match /mensagens/{messageId} {
        allow read: if belongsToWorkspace(get(/databases/$(database)/documents/conversations/$(conversationId)).data.workspaceId);
        allow create: if belongsToWorkspace(request.resource.data.workspaceId)
                      && request.resource.data.conversationId == conversationId
                      && request.resource.data.workspaceId == get(/databases/$(database)/documents/conversations/$(conversationId)).data.workspaceId
                      && request.resource.data.texto is string;
        // Transcrição de chat é append-only — nenhuma mensagem enviada é
        // editada ou apagada depois.
        allow update, delete: if false;
      }
    }

    match /messageVaults/{vaultId} {
      allow read: if false;
      allow create: if belongsToWorkspace(request.resource.data.workspaceId)
                    && request.resource.data.envelope.algoritmo == 'AES-256-GCM'
                    && request.resource.data.envelope.ciphertext is string
                    && request.resource.data.envelope.aad is string;
      allow update, delete: if false;
    }

    match /operatorProfiles/{uid} {
      allow read: if belongsToWorkspace(resource.data.workspaceId);
      // Um admin configura qualquer perfil (especialidade, capacidade); o
      // próprio operador só ajusta o seu (ex.: marcar-se indisponível).
      allow create, update: if isAdminOf(request.resource.data.workspaceId)
                            || (isSignedIn() && request.auth.uid == uid && belongsToWorkspace(request.resource.data.workspaceId));
      allow delete: if isAdminOf(resource.data.workspaceId);
    }

    match /agentProfiles/{agentId} {
      allow read: if belongsToWorkspace(resource.data.workspaceId);
      // Sub-agentes automatizados são infraestrutura, não um perfil pessoal —
      // só administradores os configuram.
      allow write: if isAdminOf(request.resource.data.workspaceId);
    }

    // ---------- Motor de campanhas com anti-ban estocástico ----------
    //
    // Campanhas em massa são uma ação de maior risco (spam, compliance) — a
    // criação e o controle de status ficam restritos a administradores. O
    // disparo de fato acontece via Admin SDK em `/api/campaigns/tick` (ver
    // `src/lib/server/campaignsAdmin.ts`), que ignora estas regras; elas
    // governam apenas o que o cliente pode fazer diretamente: criar o
    // planejamento e ler o progresso.

    match /campaigns/{campaignId} {
      allow read: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if isAdminOf(request.resource.data.workspaceId)
                    && request.resource.data.status == 'rascunho';
      allow update: if isAdminOf(resource.data.workspaceId)
                    && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if false;

      match /destinatarios/{recipientId} {
        allow read: if belongsToWorkspace(get(/databases/$(database)/documents/campaigns/$(campaignId)).data.workspaceId);
        // O cliente só planeja envios pendentes — o avanço de status
        // ("enviado"/"falhou"/"bloqueado-*") é exclusivo do Admin SDK no
        // tick do servidor, nunca de uma escrita direta do cliente.
        allow create: if isAdminOf(get(/databases/$(database)/documents/campaigns/$(campaignId)).data.workspaceId)
                      && request.resource.data.status == 'pendente';
        allow update, delete: if false;
      }
    }

    match /recipientVaults/{vaultId} {
      // Mesmo desenho de `messageVaults`/`credentialSecrets`: nenhum cliente
      // lê. A decifragem (quando um canal real de mensageria estiver
      // configurado) é server-only, no tick do servidor.
      allow read: if false;
      allow create: if belongsToWorkspace(request.resource.data.workspaceId)
                    && request.resource.data.envelope.algoritmo == 'AES-256-GCM'
                    && request.resource.data.envelope.ciphertext is string
                    && request.resource.data.envelope.aad is string;
      allow update, delete: if false;
    }

    // ---------- Refinamento funcional por nicho ----------
    //
    // Catálogo de anexos rápidos (Imobiliário/Construtoras), agendamentos
    // com janelas anti-no-show (Clínicas) e cargas rastreadas (Logística).
    // Nenhuma destas coleções é mais sensível que `flows`/`connectors` — são
    // dados operacionais do próprio workspace, não segredo nem PII em claro
    // — por isso seguem o mesmo padrão simples de leitura/escrita por
    // pertencimento, sem a camada extra de `isAdminOf` que as coleções de
    // governança exigem.

    match /nicheAttachments/{attachmentId} {
      allow read, write: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if belongsToWorkspace(request.resource.data.workspaceId);
    }

    match /appointments/{appointmentId} {
      allow read, write: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if belongsToWorkspace(request.resource.data.workspaceId);
    }

    match /shipments/{shipmentId} {
      allow read, write: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if belongsToWorkspace(request.resource.data.workspaceId);
    }

    match /contratosImobiliarios/{contratoId} {
      // Radar de Risco de Distrato (Construtora/Incorporadora) — mesmo
      // padrão simples de `appointments`/`shipments`: dado operacional do
      // workspace, não segredo nem PII em claro.
      allow read, write: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if belongsToWorkspace(request.resource.data.workspaceId);
    }

    match /pedidosEcommerce/{pedidoId} {
      // Radar de Risco de Chargeback & Devolução (E-commerce) — mesmo
      // padrão simples de `appointments`/`shipments`/`contratosImobiliarios`.
      allow read, write: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if belongsToWorkspace(request.resource.data.workspaceId);
    }

    // ---------- Full-Scope Enterprise Operations (gavetas de back-office) ----------

    match /documentosContratos/{documentoId} {
      // Document AI Vault — mesmo padrão simples de `contratosImobiliarios`.
      // `textoMascarado` é dado operacional protegido pelo Shield-Layer ANTES
      // de chegar aqui (ver `@/lib/server/documentAiVault`), nunca PII em
      // claro — por isso não precisa do mesmo bloqueio de `messageVaults`.
      allow read, write: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if belongsToWorkspace(request.resource.data.workspaceId);
    }

    match /operationalRecords/{registroId} {
      // Sheet Reconciliation — mesmo padrão simples de `shipments` (que já é,
      // na prática, uma tabela operacional reconciliada via chat para o
      // nicho de Logística; esta coleção generaliza o padrão).
      allow read, write: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if belongsToWorkspace(request.resource.data.workspaceId);
    }

    match /documentosPendentes/{documentoId} {
      // AR Recovery Engine — mesmo padrão simples de `contratosImobiliarios`.
      // Escrito tanto pelo operador (cadastro/baixa manual) quanto pelo tick
      // autônomo via Admin SDK (`/api/ar-recovery/tick`, que ignora estas
      // regras por desenho, mesmo racional de `flowRuns`/`hitlTickets`).
      allow read, write: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if belongsToWorkspace(request.resource.data.workspaceId);
    }

    match /optOuts/{optOutId} {
      // Opt-out é checado por hash, nunca pelo valor em claro — ver
      // `hashDestino()`. Qualquer membro do workspace pode registrar um
      // opt-out (um cliente pedindo para sair vale no mesmo instante em que
      // chega, não precisa esperar um admin); remover um opt-out já
      // registrado, porém, é uma decisão administrativa.
      allow read: if belongsToWorkspace(resource.data.workspaceId);
      allow create: if belongsToWorkspace(request.resource.data.workspaceId)
                    && request.resource.data.destinoHash is string;
      allow update: if false;
      allow delete: if isAdminOf(resource.data.workspaceId);
    }
  }
}
